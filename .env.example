APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mephtuts
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# AI-assisted eBook copy suggestions (Groq API)
GROQ_API_KEY=
GROQ_EBOOK_MODEL=qwen/qwen3.8-27b
# Automatic fallbacks on model-specific rate limits; these three models are available on Groq's free tier.
GROQ_EBOOK_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b
# Keep the primary model as vision-capable when analyzing scanned PDFs without OCR.
GROQ_EBOOK_VISION_MODELS=qwen/qwen3.8-27b
EBOOK_SALES_ENABLED=false
EBOOK_CHECKOUT_ATTEMPTS_PER_MINUTE=5
EBOOK_QUEUE_CONNECTION=database
EBOOK_DOWNLOAD_TTL_HOURS=48
EBOOK_MAX_DOWNLOADS=3
# Optional; defaults to gswin64c on Windows and gs on other hosts.
# EBOOK_PDF_STAMPER_BINARY=
EBOOK_PDF_STAMPER_TIMEOUT=240
# Optional Tesseract binary for OCR when a PDF contains no extractable text.
# EBOOK_OCR_BINARY=tesseract
EBOOK_THANK_YOU_URL_MINUTES=15
EBOOK_DOWNLOAD_ATTEMPTS_PER_MINUTE=12
EBOOK_RESEND_ATTEMPTS_PER_HOUR=3
EBOOK_PENDING_CHECK_MINUTES=30
EBOOK_UNFULFILLED_ALERT_MINUTES=10
EBOOK_RECONCILIATION_MINUTES=10
EBOOK_ALERT_EMAILS=info@mephed.ng
EBOOK_ALERT_DEDUPE_MINUTES=60

# Public blog foundation approved. Keep generation disabled until provider, feeds, mail, migrations, and cPanel workers are configured.
BLOG_PUBLIC_ENABLED=true
BLOG_GENERATION_ENABLED=false
BLOG_FACEBOOK_ENABLED=false
BLOG_AUTHOR_BYLINE="Author Name (MephEd)"
BLOG_AI_PROVIDER=groq
GROQ_BLOG_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_BLOG_MODEL=gemini-2.5-flash
BLOG_FACEBOOK_PAGE_NAME="MephEd Educational Services"
BLOG_FACEBOOK_PAGE_URL=https://www.facebook.com/mephed
META_GRAPH_API_VERSION=v27.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Run `php artisan schedule:run` from cPanel cron every minute and a separate
# `php artisan queue:work blog --queue=blog --stop-when-empty --tries=3 --timeout=240`
# cron task. Blog jobs use a dedicated database queue connection and do not
# change the application's existing queue or mail settings.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JITSI_DOMAIN=meet.jit.si
JITSI_APP_NAME="${APP_NAME}"
JITSI_RECORDING_ENABLED=true
# 8x8 JaaS (preferred when using 8x8.vc)
JITSI_JAAS_APP_ID=
JITSI_JAAS_KID=
JITSI_JAAS_PRIVATE_KEY=
JITSI_JAAS_PRIVATE_KEY_PATH=
JITSI_JAAS_WEBHOOK_TOKEN=
# Legacy / self-host JWT (HS256)
JITSI_JWT_APP_ID=
JITSI_JWT_APP_SECRET=
JITSI_JWT_ISS=
JITSI_JWT_SUB=
JITSI_JWT_AUD=jitsi
